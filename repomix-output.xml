      {/* Frame Wrapper */}
      <div
        className={`relative transition-all duration-300 shadow-2xl ${
          isIphone
            ? 'w-[390px] h-[812px] rounded-[50px] border-[12px] border-stone-800 bg-white ring-1 ring-stone-900/10 shadow-stone-300/60'
