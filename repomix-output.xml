# Run and deploy your AI Studio app

This contains everything you need to run your app locally.

View your app in AI Studio: https://ai.studio/apps/4ccc4b90-b373-4760-ba3e-112f0d78e10d

## Run Locally

**Prerequisites:**  Node.js


1. Install dependencies:
   `npm install`
2. Set the `GEMINI_API_KEY` in [.env.local](.env.local) to your Gemini API key
3. Run the app:
   `npm run dev`
</file>

<file path="scripts/build-and-deploy.ps1">
# Build and deploy to connected Android device
param(
    [string]$HostIP = "192.168.8.186",
    [int]$Port = 3000
)

Write-Host "=== Building web app ===" -ForegroundColor Cyan
npm run build
if ($LASTEXITCODE -ne 0) { exit 1 }

Write-Host "=== Syncing to Android ===" -ForegroundColor Cyan
npx cap sync android
if ($LASTEXITCODE -ne 0) { exit 1 }

Write-Host "=== Running Gradle build ===" -ForegroundColor Cyan
Set-Location android
.\gradlew.bat assembleDebug
if ($LASTEXITCODE -ne 0) { Set-Location ..; exit 1 }
Set-Location ..

Write-Host "=== Installing APK on device ===" -ForegroundColor Cyan
$apkPath = "android\app\build\outputs\apk\debug\app-debug.apk"
adb install -r $apkPath
if ($LASTEXITCODE -ne 0) { exit 1 }

Write-Host "=== Launching app ===" -ForegroundColor Cyan
adb shell monkey -p lk.vivah.app -c android.intent.category.LAUNCHER 1

Write-Host "=== Done! App is running on your device ===" -ForegroundColor Green
</file>

<file path="scripts/build-release.ps1">
# Build production release AAB for Google Play Store
Write-Host "=== Building web app (production) ===" -ForegroundColor Cyan
npm run build
if ($LASTEXITCODE -ne 0) { exit 1 }

Write-Host "=== Syncing to Android ===" -ForegroundColor Cyan
npx cap sync android
if ($LASTEXITCODE -ne 0) { exit 1 }

Write-Host "=== Building Release AAB ===" -ForegroundColor Cyan
Set-Location android
.\gradlew.bat bundleRelease
if ($LASTEXITCODE -ne 0) { Set-Location ..; exit 1 }
Set-Location ..

$aabPath = "android\app\build\outputs\bundle\release\app-release.aab"
Write-Host "`n=== Release AAB built successfully! ===" -ForegroundColor Green
Write-Host "Output: $aabPath" -ForegroundColor Yellow
Write-Host "`nUpload this file to Google Play Console:" -ForegroundColor Cyan
