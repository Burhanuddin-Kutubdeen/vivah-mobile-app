              {/* Life & Background */}
              <button className="w-full p-4 flex items-center justify-between hover:bg-stone-50 transition-all">
                <div className="flex items-center gap-3 flex-1">
                  <GraduationCap className="w-5 h-5 text-[#5A5A40] shrink-0" />
