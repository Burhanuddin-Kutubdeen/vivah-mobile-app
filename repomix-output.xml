import React from 'react';
import { CandidateProfile } from '../types';
import { toPascalCase } from '../lib/formatters';
import { 
  X, 
  Heart, 
  Sparkles, 
  MessageSquare,
  Users, 
  Cake, 
  Ruler, 
  GraduationCap, 
  School, 
  Briefcase, 
