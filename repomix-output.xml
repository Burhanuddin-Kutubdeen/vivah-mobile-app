          <div className="p-4 sm:p-5 space-y-4">
            {/* Header: Name + Verification Pill */}
            <div className="flex items-center justify-between gap-2 border-b border-[#5A5A40]/15 pb-3">
              <div className="flex items-center gap-2 flex-wrap">
                <h2 className="text-xl font-serif font-bold text-[#2A2A2A]">
                  {toPascalCase(formData.name)}
                </h2>
                {formData.verified && (
                  <div className="bg-[#5A5A40]/10 border border-[#5A5A40]/20 text-[#5A5A40] px-2.5 py-0.5 rounded-full text-[11px] font-sans font-bold flex items-center gap-1">
                    <Check className="w-3.5 h-3.5 text-[#5A5A40] stroke-[3]" />
                    <span>Verified</span>
                  </div>
                )}
              </div>
            </div>

            {/* Primary Profile Image */}
            {formData.avatarUrl && (
              <div className="relative aspect-[4/5] w-full rounded-[28px] overflow-hidden bg-stone-200 shadow-sm">
                <img
                  src={formData.avatarUrl}
                  alt={formData.name}
                  referrerPolicy="no-referrer"
                  className="w-full h-full object-cover object-center"
                />
              </div>
            )}

            {/* About Me */}
            {formData.bio && (
              <div className="space-y-1.5 px-1">
                <h3 className="font-sans font-semibold text-[#2A2A2A] text-sm">About me</h3>
                <p className="text-xs text-[#2A2A2A]/90 font-sans leading-relaxed whitespace-pre-line">
                  {formData.bio}
                </p>
              </div>
            )}

            {/* Key Stats Card */}
            <div className="bg-[#fcfcf9] border border-[#5A5A40]/30 rounded-[22px] px-4 py-1 text-xs text-[#2A2A2A] shadow-2xs font-sans">
              {formData.age > 0 && (
                <>
                  <div className="py-3 flex items-center gap-3">
                    <Cake className="w-4 h-4 text-[#8a804a] shrink-0" />
                    <span className="font-medium text-[#2A2A2A]">{formData.age} Yrs</span>
                  </div>
                  <div className="h-px bg-[#5A5A40]/12 mx-1" />
                </>
              )}

              {formData.height && (
                <>
                  <div className="py-3 flex items-center gap-3">
                    <Ruler className="w-4 h-4 text-[#8a804a] shrink-0" />
                    <span className="font-medium text-[#2A2A2A]">{formData.height}</span>
                  </div>
                  <div className="h-px bg-[#5A5A40]/12 mx-1" />
                </>
              )}

              {formData.career.highestDegree && (
                <>
                  <div className="py-3 flex items-center gap-3">
                    <GraduationCap className="w-4 h-4 text-[#8a804a] shrink-0" />
                    <span className="font-medium text-[#2A2A2A]">{formData.career.highestDegree}</span>
                  </div>
                  <div className="h-px bg-[#5A5A40]/12 mx-1" />
                </>
              )}

              {formData.career.collegeName && (
                <>
                  <div className="py-3 flex items-center gap-3">
                    <School className="w-4 h-4 text-[#8a804a] shrink-0" />
                    <span className="font-medium text-[#2A2A2A]">{formData.career.collegeName}</span>
                  </div>
                  <div className="h-px bg-[#5A5A40]/12 mx-1" />
                </>
              )}

              {formData.career.profession && (
                <div className="py-3 flex items-center gap-3">
                  <Briefcase className="w-4 h-4 text-[#8a804a] shrink-0" />
                  <span className="font-medium text-[#2A2A2A]">{formData.career.profession}</span>
                </div>
              )}
            </div>

            {/* Location Card */}
            {(formData.location.city || formData.location.state || formData.location.country) && (
              <div className="bg-[#fcfcf9] border border-[#5A5A40]/30 rounded-[22px] px-4 py-3 flex items-center gap-2.5 text-xs font-medium text-[#2A2A2A] shadow-2xs font-sans">
                <Navigation className="w-4 h-4 text-[#8a804a] shrink-0 rotate-45" />
                <span>
                  {[formData.location.city, formData.location.state, formData.location.country].filter(Boolean).join(', ')}
                </span>
              </div>
            )}

            {/* Personal Details Card */}
            {(formData.religion || formData.caste || formData.maritalStatus) && (
              <div className="bg-[#fcfcf9] border border-[#5A5A40]/30 rounded-[22px] px-4 py-1 text-xs text-[#2A2A2A] shadow-2xs font-sans">
                {(formData.religion || formData.caste) && (
                  <>
                    <div className="py-3 flex items-center justify-between gap-2">
                      <div className="flex items-center gap-2.5 text-[#2A2A2A]/90">
                        <Sparkles className="w-4 h-4 text-[#8a804a] shrink-0" />
                        <span>Religion & Caste</span>
                      </div>
                      <span className="border border-[#5A5A40]/35 rounded-full px-3 py-1 bg-[#5A5A40]/5 text-[11px] font-medium text-[#2A2A2A]">
                        {formData.religion}{formData.caste ? ` (${formData.caste})` : ''}
                      </span>
                    </div>
                    <div className="h-px bg-[#5A5A40]/12 mx-1" />
                  </>
                )}

                {formData.maritalStatus && (
                  <div className="py-3 flex items-center justify-between gap-2">
                    <div className="flex items-center gap-2.5 text-[#2A2A2A]/90">
                      <Users className="w-4 h-4 text-[#8a804a] shrink-0" />
                      <span>Marital Status</span>
                    </div>
                    <span className="border border-[#5A5A40]/35 rounded-full px-3 py-1 bg-[#5A5A40]/5 text-[11px] font-medium text-[#2A2A2A]">
                      {formData.maritalStatus}
                    </span>
                  </div>
                )}
              </div>
            )}

            {/* Photo Gallery */}
            {photos.length > 0 && (
              <div className="space-y-2">
                <h3 className="font-sans font-semibold text-[#2A2A2A] text-sm px-1">Photos</h3>
                <div className="grid grid-cols-3 gap-2">
                  {photos.map((photo, idx) => (
                    <div
                      key={idx}
                      className="aspect-[3/4] rounded-2xl overflow-hidden border border-[#5A5A40]/15 bg-stone-100"
                    >
                      <img
                        src={photo}
                        alt={`Photo ${idx + 1}`}
                        referrerPolicy="no-referrer"
                        className="w-full h-full object-cover"
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        ) : (
          /* ===== EDIT MODE ===== */
          <div className="px-4 sm:px-6 py-5 space-y-0">
            {/* Photos Section */}
            <h3 className="font-serif font-bold text-[#2A2A2A] text-base mb-3">
              Photos
            </h3>

            <div className="grid grid-cols-3 gap-3 mb-5">
              {photos.map((photo, idx) => (
                <div
                  key={idx}
                  className="aspect-[3/4] rounded-2xl overflow-hidden border border-[#5A5A40]/15 bg-stone-100"
                >
                  <img
                    src={photo}
                    alt={`Photo ${idx + 1}`}
                    referrerPolicy="no-referrer"
                    className="w-full h-full object-cover"
                  />
                </div>
              ))}

              {hasUploadSlot && (
                <button
                  type="button"
                  className="aspect-[3/4] rounded-2xl border-2 border-dashed border-[#5A5A40]/30 bg-[#5A5A40]/5 flex flex-col items-center justify-center gap-2 text-[#5A5A40]/60 hover:border-[#5A5A40]/50 hover:bg-[#5A5A40]/10 hover:text-[#5A5A40] transition-all active:scale-95"
                >
                  <ImagePlus className="w-8 h-8" />
                  <span className="text-[10px] font-bold uppercase tracking-wider">Add Photo</span>
                </button>
              )}
            </div>

            {/* Inset Divider */}
            <div className="mx-6 border-t border-[#5A5A40]/15" />

            {/* About Me Section */}
            <div className="pt-5 space-y-3">
              <h3 className="font-serif font-bold text-[#2A2A2A] text-base">
                About Me
              </h3>

              <textarea
                rows={4}
                value={formData.bio}
                onChange={(e) => updateField('bio', e.target.value)}
                onBlur={() => updateField('bio', formData.bio, true)}
                placeholder="Tell others about yourself..."
                className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-3 text-xs text-[#2A2A2A] leading-relaxed focus:outline-none focus:border-[#5A5A40]"
              />
            </div>

            {/* Basic Personal Details */}
            <div className="pt-5 space-y-3">
              <h3 className="font-serif font-bold text-[#2A2A2A] text-base">
                Basic Details
              </h3>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[#5A5A40] font-bold text-[10px] uppercase tracking-wider mb-1">Name</label>
                  <input
                    type="text"
                    value={formData.name}
                    onChange={(e) => updateField('name', e.target.value)}
                    onBlur={() => updateField('name', formData.name, true)}
                    className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-2 text-xs text-[#2A2A2A]"
                  />
                </div>

                <div>
                  <label className="block text-[#5A5A40] font-bold text-[10px] uppercase tracking-wider mb-1">Age</label>
                  <input
                    type="number"
                    value={formData.age || ''}
                    onChange={(e) => updateField('age', parseInt(e.target.value) || 0)}
                    onBlur={() => updateField('age', formData.age, true)}
                    className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-2 text-xs text-[#2A2A2A]"
                  />
                </div>

                <div>
                  <label className="block text-[#5A5A40] font-bold text-[10px] uppercase tracking-wider mb-1">Height</label>
                  <input
                    type="text"
                    value={formData.height}
                    onChange={(e) => updateField('height', e.target.value)}
                    onBlur={() => updateField('height', formData.height, true)}
                    className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-2 text-xs text-[#2A2A2A]"
                  />
                </div>

                <div>
                  <label className="block text-[#5A5A40] font-bold text-[10px] uppercase tracking-wider mb-1">Marital Status</label>
                  <select
                    value={formData.maritalStatus}
                    onChange={(e) => updateField('maritalStatus', e.target.value as any)}
                    onBlur={() => updateField('maritalStatus', formData.maritalStatus, true)}
                    className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-2 text-xs text-[#2A2A2A]"
                  >
                    <option value="">Select</option>
                    <option value="Never Married">Never Married</option>
                    <option value="Widowed">Widowed</option>
                    <option value="Divorced">Divorced</option>
                    <option value="Separated">Separated</option>
                    <option value="Awaiting Divorce">Awaiting Divorce</option>
                  </select>
                </div>
              </div>
            </div>

            {/* Education & Career */}
            <div className="pt-5 space-y-3">
              <h3 className="font-serif font-bold text-[#2A2A2A] text-base">
                Education & Career
              </h3>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[#5A5A40] font-bold text-[10px] uppercase tracking-wider mb-1">Profession</label>
                  <input
                    type="text"
                    value={formData.career.profession}
                    onChange={(e) => updateNestedField('career', 'profession', e.target.value)}
                    onBlur={() => updateNestedField('career', 'profession', formData.career.profession, true)}
                    className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-2 text-xs text-[#2A2A2A]"
                  />
                </div>

                <div>
                  <label className="block text-[#5A5A40] font-bold text-[10px] uppercase tracking-wider mb-1">Highest Degree</label>
                  <input
                    type="text"
                    value={formData.career.highestDegree}
                    onChange={(e) => updateNestedField('career', 'highestDegree', e.target.value)}
                    onBlur={() => updateNestedField('career', 'highestDegree', formData.career.highestDegree, true)}
                    className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-2 text-xs text-[#2A2A2A]"
                  />
                </div>
              </div>
            </div>

            {/* Location */}
            <div className="pt-5 space-y-3">
              <h3 className="font-serif font-bold text-[#2A2A2A] text-base">
                Location
              </h3>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[#5A5A40] font-bold text-[10px] uppercase tracking-wider mb-1">City</label>
                  <input
                    type="text"
                    value={formData.location.city}
                    onChange={(e) => updateNestedField('location', 'city', e.target.value)}
                    onBlur={() => updateNestedField('location', 'city', formData.location.city, true)}
                    className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-2 text-xs text-[#2A2A2A]"
                  />
                </div>

                <div>
                  <label className="block text-[#5A5A40] font-bold text-[10px] uppercase tracking-wider mb-1">State</label>
                  <input
                    type="text"
                    value={formData.location.state}
                    onChange={(e) => updateNestedField('location', 'state', e.target.value)}
                    onBlur={() => updateNestedField('location', 'state', formData.location.state, true)}
                    className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-2 text-xs text-[#2A2A2A]"
                  />
                </div>

                <div>
                  <label className="block text-[#5A5A40] font-bold text-[10px] uppercase tracking-wider mb-1">Country</label>
                  <input
                    type="text"
                    value={formData.location.country}
                    onChange={(e) => updateNestedField('location', 'country', e.target.value)}
                    onBlur={() => updateNestedField('location', 'country', formData.location.country, true)}
                    className="w-full bg-white border border-[#5A5A40]/20 rounded-xl p-2 text-xs text-[#2A2A2A]"
                  />
                </div>
              </div>
            </div>

            {/* Bottom Done Button */}
            <div className="pt-6 pb-6">
              <button
                onClick={onClose}
                className="w-full py-3 bg-[#5A5A40] hover:bg-[#4a4a34] text-white font-bold rounded-2xl transition-all text-xs uppercase tracking-wider shadow-md"
              >
                Done
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/components/MyProfileView.tsx">
import React, { useState } from 'react';
import { CandidateProfile } from '../types';
import { toPascalCase } from '../lib/formatters';
import { CheckCircle2, Pencil, Crown, SlidersHorizontal, RefreshCw } from 'lucide-react';
import { EditProfileView } from './EditProfileView';

interface MyProfileViewProps {
  userProfile: CandidateProfile;
  setUserProfile: React.Dispatch<React.SetStateAction<CandidateProfile>>;
  credits?: number;
  maxCredits?: number;
  timeUntilReset?: string;
}

export const MyProfileView: React.FC<MyProfileViewProps> = ({ userProfile, setUserProfile, credits = 5, maxCredits = 5, timeUntilReset = '' }) => {
  const [activeTab, setActiveTab] = useState<'details' | 'preferences'>('details');
  const [showEditProfile, setShowEditProfile] = useState(false);

  if (showEditProfile) {
    return (
      <EditProfileView
        userProfile={userProfile}
        setUserProfile={setUserProfile}
        onClose={() => setShowEditProfile(false)}
      />
    );
  }

  return (
    <div className="flex-1 flex flex-col bg-[#f5f5f0] text-[#2A2A2A] overflow-y-auto pb-6 font-sans">
      {/* Profile Header */}
      <div className="bg-white p-6 border-b border-[#5A5A40]/15 flex flex-col items-center justify-center text-center gap-4 shadow-2xs">
        <div
          onClick={() => setShowEditProfile(true)}
          className="relative group cursor-pointer"
          title="View & Edit Profile Information"
        >
          {userProfile.avatarUrl ? (
            <img
              src={userProfile.avatarUrl}
              alt={userProfile.name}
              referrerPolicy="no-referrer"
              className="w-28 h-28 rounded-full object-cover border-2 border-[#5A5A40]/30 shadow-sm transition-transform group-hover:scale-102"
            />
          ) : (
            <div className="w-28 h-28 rounded-full bg-[#5A5A40]/10 border-2 border-[#5A5A40]/30 flex items-center justify-center">
              <span className="text-4xl font-serif font-bold text-[#5A5A40]">
                {userProfile.name ? userProfile.name.charAt(0).toUpperCase() : '?'}
              </span>
            </div>
          )}
          <button
            type="button"
            onClick={(e) => {
              e.stopPropagation();
              setShowEditProfile(true);
            }}
            className="absolute bottom-0 right-0 w-9 h-9 rounded-full bg-white border border-[#5A5A40]/30 shadow-md flex items-center justify-center text-[#5A5A40] hover:bg-stone-100 hover:scale-105 active:scale-95 transition-all cursor-pointer"
            title="Edit Profile Info"
          >
            <Pencil className="w-5 h-5 text-[#5A5A40]" />
          </button>
        </div>
        <div className="flex flex-col items-center">
          <div className="flex items-center justify-center gap-2">
            <h2 className="text-2xl font-serif font-bold text-[#2A2A2A]">{toPascalCase(userProfile.name)}</h2>
            {userProfile.verified && <CheckCircle2 className="w-5 h-5 text-[#5A5A40]" />}
          </div>
          {(userProfile.career.profession || userProfile.location.city) && (
            <p className="text-sm text-[#5A5A40] font-sans mt-1">
              {userProfile.career.profession}{userProfile.location.city ? ` • ${userProfile.location.city}` : ''}
            </p>
          )}
          <span className="text-xs bg-[#5A5A40]/10 text-[#5A5A40] border border-[#5A5A40]/20 px-4 py-1 rounded-full font-bold uppercase tracking-wider inline-block mt-2">
            Verified Premium Member
          </span>
        </div>
      </div>

      {/* Sub Tabs */}
      <div className="flex border-b border-[#5A5A40]/15 bg-white text-sm font-sans">
        <button
          onClick={() => setActiveTab('details')}
          className={`flex-1 py-3.5 font-bold transition-all border-b-2 uppercase tracking-wider text-xs ${
            activeTab === 'details'
              ? 'border-[#5A5A40] text-[#5A5A40] bg-[#f5f5f0]/50'
              : 'border-transparent text-[#5A5A40]/60 hover:text-[#2A2A2A]'
          }`}
        >
          Membership
        </button>

        <button
          onClick={() => setActiveTab('preferences')}
          className={`flex-1 py-3.5 font-bold transition-all border-b-2 uppercase tracking-wider text-xs ${
            activeTab === 'preferences'
              ? 'border-[#5A5A40] text-[#5A5A40] bg-[#f5f5f0]/50'
              : 'border-transparent text-[#5A5A40]/60 hover:text-[#2A2A2A]'
          }`}
        >
          Preferences
        </button>
      </div>

      {/* Tab Content */}
      <div className="p-4 space-y-4 text-sm font-sans">
        {activeTab === 'details' && (
          <div className="space-y-4">
            {/* Membership Card */}
            <div className="bg-gradient-to-br from-amber-50 to-stone-50 border border-amber-200 p-5 rounded-2xl shadow-xs">
              <div className="space-y-3 text-sm">
                <div className="flex justify-between items-center">
                  <span className="text-[#5A5A40] font-medium">Your Membership</span>
                  <span className="font-bold text-[#2A2A2A] text-base">Free</span>
                </div>
                <div className="flex justify-between items-center">
                  <span className="text-[#5A5A40] font-medium">Profile Views</span>
                  <span className="font-semibold text-[#2A2A2A]">5 profiles per day</span>
                </div>
              </div>
            </div>

            {/* Daily Credits Widget */}
            <div className="bg-white border border-[#5A5A40]/15 p-4 rounded-2xl shadow-xs">
              <div className="text-center">
                <span className="font-bold text-[#2A2A2A] text-sm">Daily Profile Views</span>
                <div className="text-4xl font-serif font-bold text-[#5A5A40] mt-1">{credits}</div>
              </div>

              {/* Refresh Timer */}
              <div className="flex items-center justify-center gap-2 text-xs text-[#5A5A40] mt-3 pt-3 border-t border-[#5A5A40]/10">
                <RefreshCw className="w-4 h-4 text-[#5A5A40]" />
                <span>Refreshes in {timeUntilReset}</span>
              </div>
            </div>
          </div>
        )}

        {activeTab === 'preferences' && (
          <div className="space-y-4">
            <div className="bg-white border border-[#5A5A40]/15 p-4 rounded-2xl space-y-3 shadow-2xs">
              <div className="flex items-center gap-2.5 text-[#5A5A40] font-bold">
                <SlidersHorizontal className="w-5 h-5 text-[#5A5A40]" />
                <span className="text-sm">Partner Preferences</span>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[#5A5A40]/80 text-xs uppercase tracking-wider mb-1.5">Age Range</label>
                  <div className="bg-[#f5f5f0] border border-[#5A5A40]/20 rounded-xl p-2.5 text-sm text-[#2A2A2A]">
                    {userProfile.partnerPreferences.ageMin} – {userProfile.partnerPreferences.ageMax} yrs
                  </div>
                </div>

                <div>
                  <label className="block text-[#5A5A40]/80 text-xs uppercase tracking-wider mb-1.5">Marital Status</label>
                  <div className="bg-[#f5f5f0] border border-[#5A5A40]/20 rounded-xl p-2.5 text-sm text-[#2A2A2A]">
                    {userProfile.partnerPreferences.maritalStatus.length > 0
                      ? userProfile.partnerPreferences.maritalStatus.join(', ')
                      : 'Any'}
                  </div>
                </div>

                <div>
                  <label className="block text-[#5A5A40]/80 text-xs uppercase tracking-wider mb-1.5">Religion</label>
                  <div className="bg-[#f5f5f0] border border-[#5A5A40]/20 rounded-xl p-2.5 text-sm text-[#2A2A2A]">
                    {userProfile.partnerPreferences.religion.length > 0
                      ? userProfile.partnerPreferences.religion.join(', ')
                      : 'Any'}
                  </div>
                </div>

                <div>
                  <label className="block text-[#5A5A40]/80 text-xs uppercase tracking-wider mb-1.5">Mother Tongue</label>
                  <div className="bg-[#f5f5f0] border border-[#5A5A40]/20 rounded-xl p-2.5 text-sm text-[#2A2A2A]">
                    {userProfile.partnerPreferences.motherTongue.length > 0
                      ? userProfile.partnerPreferences.motherTongue.join(', ')
                      : 'Any'}
                  </div>
                </div>

                <div>
                  <label className="block text-[#5A5A40]/80 text-xs uppercase tracking-wider mb-1.5">Diet</label>
                  <div className="bg-[#f5f5f0] border border-[#5A5A40]/20 rounded-xl p-2.5 text-sm text-[#2A2A2A]">
                    {userProfile.partnerPreferences.diet.length > 0
                      ? userProfile.partnerPreferences.diet.join(', ')
                      : 'Any'}
                  </div>
                </div>

                <div>
                  <label className="block text-[#5A5A40]/80 text-xs uppercase tracking-wider mb-1.5">Min Income</label>
                  <div className="bg-[#f5f5f0] border border-[#5A5A40]/20 rounded-xl p-2.5 text-sm text-[#2A2A2A]">
                    {userProfile.partnerPreferences.minIncome || 'Not specified'}
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/components/OnboardingScreen.tsx">
import React, { useState, useRef } from 'react';
import { Geolocation } from '@capacitor/geolocation';
import { PushNotifications } from '@capacitor/push-notifications';
import {
  Heart,
  ShieldCheck,
  Sparkles,
  Users,
  ChevronLeft,
  ChevronUp,
  ChevronDown,
  Calendar,
