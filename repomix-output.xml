import express from "express";
import path from "path";
import { createServer as createViteServer } from "vite";
import { GoogleGenAI } from "@google/genai";
import dotenv from "dotenv";

dotenv.config();

const app = express();
const PORT = 3000;

app.use(express.json());

// Initialize Gemini API client safely
function getGeminiAI() {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) {
    return null;
  }
  return new GoogleGenAI({ apiKey });
}

// Health check endpoint
app.get("/api/health", (req, res) => {
  res.json({
    status: "ok",
    appName: "Vivah Matrimony",
    timestamp: new Date().toISOString(),
    hasGeminiKey: !!process.env.GEMINI_API_KEY
  });
});

// AI Profile Compatibility Analysis Endpoint
app.post("/api/gemini/match-analysis", async (req, res) => {
  try {
    const ai = getGeminiAI();
    if (!ai) {
      return res.status(503).json({
        error: "Gemini API Key is missing. Please configure GEMINI_API_KEY in environment secrets."
      });
    }

    const { userProfile, candidateProfile } = req.body;

    const prompt = `You are Vivah's expert AI Matrimony Compatibility & Astrological Advisor.
Analyze the compatibility between these two matrimony profiles for marriage.

User Profile:
- Name: ${userProfile?.name || 'User'}
- Age/Height: ${userProfile?.age || '28'} y/o, ${userProfile?.height || "5'8\""}
- Profession: ${userProfile?.profession || 'Software Engineer'}
- Religion/Caste: ${userProfile?.religion || 'Hindu'}, ${userProfile?.caste || 'Brahmin'}
- Rashi/Nakshatra: ${userProfile?.rashi || 'Vrishabha'}, ${userProfile?.nakshatra || 'Rohini'}
- Diet/Lifestyle: ${userProfile?.diet || 'Vegetarian'}, ${userProfile?.lifestyle || 'Non-smoker'}
- Location: ${userProfile?.city || 'Mumbai'}
- Family Background: ${userProfile?.familyType || 'Joint Family'}, ${userProfile?.familyValues || 'Traditional & Modern Blend'}

Candidate Profile:
- Name: ${candidateProfile?.name || 'Candidate'}
- Age/Height: ${candidateProfile?.age} y/o, ${candidateProfile?.height}
- Profession: ${candidateProfile?.profession}
- Religion/Caste: ${candidateProfile?.religion}, ${candidateProfile?.caste}
- Rashi/Nakshatra: ${candidateProfile?.rashi}, ${candidateProfile?.nakshatra}
- Diet/Lifestyle: ${candidateProfile?.diet}, ${candidateProfile?.lifestyle}
- Location: ${candidateProfile?.city}
- Family Background: ${candidateProfile?.familyType}, ${candidateProfile?.familyValues}

Provide a JSON object response with exact keys:
1. "overallCompatibilityPercentage": number (between 70 and 99)
2. "gunaMilanScore": string (e.g. "31/36")
3. "summary": string (2-3 sentences summarizing core synergy)
4. "strengths": string array (3 key matching factors like shared career values, astrological harmony, lifestyle alignment)
5. "considerations": string array (1-2 respectful points for discussion, e.g. relocation, family setup)
6. "astrologicalInsight": string (brief horoscope/guna perspective)

Respond ONLY with valid JSON.`;

    const response = await ai.models.generateContent({
      model: "gemini-2.5-flash",
      contents: prompt,
      config: {
        responseMimeType: "application/json"
      }
    });

    const text = response.text || "{}";
    const data = JSON.parse(text);
    return res.json({ success: true, analysis: data });
  } catch (error: any) {
    console.error("Gemini Match Analysis Error:", error);
    return res.status(500).json({ error: error?.message || "Failed to generate match analysis" });
  }
});

// AI Bio Generator Endpoint
app.post("/api/gemini/generate-bio", async (req, res) => {
  try {
    const ai = getGeminiAI();
    if (!ai) {
      return res.status(503).json({
        error: "Gemini API Key is missing. Please configure GEMINI_API_KEY in environment secrets."
      });
    }

    const { profession, education, hobbies, values, familyType, lookingFor } = req.body;

    const prompt = `Write a graceful, dignified, and compelling Matrimony About Me profile description (bio) in English suitable for an Indian matrimony platform (Vivah).
User Details:
- Profession: ${profession || 'Software Architect'}
- Education: ${education || 'B.Tech in Computer Science'}
- Hobbies/Interests: ${hobbies || 'Travelling, classical music, cooking, fitness'}
- Core Values: ${values || 'Family-oriented, respects traditions while having a progressive mindset'}
- Family Setup: ${familyType || 'Nuclear family with deep rooted warmth'}
- Looking For: ${lookingFor || 'A compassionate, educated, and supportive partner'}

Generate a JSON response with:
{
  "bio": "A well-written 3-paragraph bio summarizing personality, career aspirations, family values, and what they seek in a life partner.",
  "headline": "A short, catchy headline (e.g. 'Software Professional with Warm Family Values & Passion for Travel')"
}
Return ONLY valid JSON.`;

    const response = await ai.models.generateContent({
      model: "gemini-2.5-flash",
      contents: prompt,
      config: {
        responseMimeType: "application/json"
      }
    });

    const text = response.text || "{}";
    const data = JSON.parse(text);
    return res.json({ success: true, result: data });
  } catch (error: any) {
    console.error("Gemini Bio Generator Error:", error);
    return res.status(500).json({ error: error?.message || "Failed to generate bio" });
  }
});

async function startServer() {
  if (process.env.NODE_ENV !== "production") {
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: "spa",
    });
    app.use(vite.middlewares);
  } else {
    const distPath = path.join(process.cwd(), "dist");
    app.use(express.static(distPath));
    app.get("*", (req, res) => {
      res.sendFile(path.join(distPath, "index.html"));
    });
  }

  app.listen(PORT, "0.0.0.0", () => {
    console.log(`Vivah Server running on http://0.0.0.0:${PORT}`);
  });
}

startServer();
</file>

<file path="src/App.tsx">
import React, { useState, useEffect } from 'react';
import { CandidateProfile, FilterState, ChatMessage, ConnectionRequest, SupabaseConfig, TabType } from './types';
import { INITIAL_MOCK_PROFILES, INITIAL_USER_PROFILE } from './data/mockProfiles';
import { getSavedSupabaseConfig, syncLikeToSupabase, syncUnlikeToSupabase, syncMessageToSupabase, syncProfileToSupabase, fetchInitialSupabaseData } from './lib/supabase';
import { toPascalCase } from './lib/formatters';
import { useWebRTCCall } from './hooks/useWebRTCCall';
import { useDailyCredits } from './hooks/useDailyCredits';
import { CallOverlay } from './components/CallOverlay';
import { FlutterDeviceFrame } from './components/FlutterDeviceFrame';
import { BottomNavBar } from './components/BottomNavBar';
import { DiscoverView } from './components/DiscoverView';
import { FilterDrawer } from './components/FilterDrawer';
import { ProfileDetailModal } from './components/ProfileDetailModal';
import { SecureChatView } from './components/SecureChatView';
import { LikesView } from './components/LikesView';
import { MyProfileView } from './components/MyProfileView';
import { OnboardingScreen } from './components/OnboardingScreen';
import { AuthLoginScreen } from './components/AuthLoginScreen';

const isCapacitorNative =
  typeof window !== 'undefined' &&
  Boolean((window as any).Capacitor?.isNativePlatform?.());

export default function App() {
  // Navigation Tab State
  const [activeTab, setActiveTab] = useState<TabType>('discover');

  // Supabase Config State
  const [supabaseConfig, setSupabaseConfig] = useState<SupabaseConfig>(getSavedSupabaseConfig());

  // Profiles State
  const [candidates, setCandidates] = useState<CandidateProfile[]>(INITIAL_MOCK_PROFILES);
  const [userProfile, setUserProfile] = useState<CandidateProfile>(INITIAL_USER_PROFILE);
  const [selectedCandidate, setSelectedCandidate] = useState<CandidateProfile | null>(null);

  // Likes & Skipped State
  const [shortlistedIds, setShortlistedIds] = useState<string[]>(['vivah-prof-1', 'vivah-prof-6']);
  const [interestedIds, setInterestedIds] = useState<string[]>(['vivah-prof-1']);
  const [skippedIds, setSkippedIds] = useState<string[]>(['vivah-prof-5']);

  // Connection Requests
  const [connectionRequests, setConnectionRequests] = useState<ConnectionRequest[]>([
    {
      id: 'req-1',
      fromUserId: 'vivah-prof-3',
      toProfileId: 'current-user-123',
      status: 'pending',
      sentAt: '2 hours ago',
      message: 'Hello Aarav! Our families share similar academic and cultural background.'
    }
  ]);

  // Messages State
  const [messages, setMessages] = useState<ChatMessage[]>([
    {
      id: 'msg-1',
      matchId: 'vivah-prof-1',
      senderId: 'vivah-prof-1',
      text: 'Namaste Aarav! Thank you for expressing interest. I liked your bio and IT background.',
      timestamp: '10:30 AM',
      status: 'read'
    },
    {
      id: 'msg-2',
      matchId: 'vivah-prof-1',
      senderId: 'currentUser',
      text: 'Hello Ananya! Great to connect. Our Guna Milan score of 32/36 is wonderful.',
      timestamp: '10:32 AM',
      status: 'read'
    }
  ]);

  const [activeChatProfile, setActiveChatProfile] = useState<CandidateProfile | null>(null);

  // WebRTC Call State
  const {
    callState,
    callType,
    remotePeerId,
    incomingCall,
    localStream,
    remoteStream,
    isMuted,
    isCameraOff,
    startCall,
    acceptCall,
    declineCall,
    endCall,
    toggleMute,
    toggleCamera,
  } = useWebRTCCall('current-user-123');

  // Daily Credits for swipe limits
  const {
    credits,
    maxCredits,
    timeUntilReset,
    spendCredit,
  } = useDailyCredits();

  // Filter State
  const [isFilterOpen, setIsFilterOpen] = useState(false);
  const [filters, setFilters] = useState<FilterState>({
    gender: 'Female', // Default bride recommendation
    ageMin: 22,
    ageMax: 35,
    heightMinInches: 58,
    heightMaxInches: 74,
    religions: [],
    castes: [],
    maritalStatuses: ['Never Married'],
    minIncome: '',
    city: '',
    state: '',
    manglikPreference: 'All',
    verifiedOnly: false,
    withPhotosOnly: true,
    searchQuery: ''
  });

  // Login / Signup State (set to false to show post-signup onboarding & main views)
  const [showLoginScreen, setShowLoginScreen] = useState<boolean>(false);

  // Onboarding State (TEMPORARILY disabled for main app development)
  const [showOnboarding, setShowOnboarding] = useState<boolean>(false);

  const handleLoginSuccess = (userEmail?: string, userName?: string) => {
    try { localStorage.setItem('vivah_logged_in_v1', 'true'); } catch { /* ignore */ }
    setShowLoginScreen(false);
    if (userName) {
      setUserProfile((prev) => ({
        ...prev,
        name: userName
      }));
    }
  };

  const handleCompleteOnboarding = (
    updatedFilters?: Partial<FilterState>,
    userName?: string,
    locationData?: { country?: string; city?: string; state?: string },
    profileData?: {
      name?: string;
      gender?: string;
      age?: number;
      height?: string;
      bio?: string;
      religion?: string;
      motherTongue?: string;
      caste?: string;
      maritalStatus?: string;
      diet?: string;
      education?: string;
      profession?: string;
      location?: { country?: string; city?: string; state?: string };
      photos?: string[];
      avatarUrl?: string;
    }
  ) => {
    try { localStorage.setItem('vivah_onboarding_completed_v1', 'true'); } catch { /* ignore */ }
    setShowOnboarding(false);
    if (updatedFilters) {
      setFilters((prev) => ({
        ...prev,
        ...updatedFilters
      }));
    }

    // Update user profile with all onboarding data
    setUserProfile((prev) => {
      const updated = { ...prev };
      if (profileData) {
        if (profileData.name) updated.name = profileData.name;
        if (profileData.gender) updated.gender = profileData.gender as any;
        if (profileData.age) updated.age = profileData.age;
        if (profileData.height) updated.height = profileData.height;
        if (profileData.bio !== undefined) updated.bio = profileData.bio;
        if (profileData.religion) updated.religion = profileData.religion;
        if (profileData.motherTongue) updated.motherTongue = profileData.motherTongue;
        if (profileData.caste) updated.caste = profileData.caste;
        if (profileData.maritalStatus) updated.maritalStatus = profileData.maritalStatus as any;
        if (profileData.diet) updated.diet = profileData.diet;
        if (profileData.education) updated.career.highestDegree = profileData.education;
        if (profileData.profession) updated.career.profession = profileData.profession;
        if (profileData.photos && profileData.photos.length > 0) {
          updated.photos = profileData.photos;
          updated.avatarUrl = profileData.photos[0];
        } else if (profileData.avatarUrl) {
          updated.avatarUrl = profileData.avatarUrl;
        }
      }
      // Update location from onboarding detection
      if (locationData && (locationData.country || locationData.city || locationData.state)) {
        updated.location = {
          city: locationData.city || prev.location.city,
          state: locationData.state || prev.location.state,
          country: locationData.country || prev.location.country
        };
      }
      return updated;
    });
  };

  // Sync User Profile changes to Supabase
  useEffect(() => {
    if (supabaseConfig.isConnected) {
      syncProfileToSupabase(userProfile);
    }
  }, [userProfile, supabaseConfig.isConnected]);

  // Load initial Supabase data when connected
  useEffect(() => {
    if (supabaseConfig.isConnected) {
      fetchInitialSupabaseData(userProfile.id).then((data) => {
        if (!data) return;
        if (data.interestedCandidateIds && data.interestedCandidateIds.length > 0) {
          setInterestedIds((prev) => Array.from(new Set([...prev, ...data.interestedCandidateIds])));
        }
        if (data.shortlistedCandidateIds && data.shortlistedCandidateIds.length > 0) {
          setShortlistedIds((prev) => Array.from(new Set([...prev, ...data.shortlistedCandidateIds])));
        }
        if (data.chatMessages && data.chatMessages.length > 0) {
          setMessages((prev) => {
            const existingIds = new Set(prev.map((m) => m.id));
            const newMsgs = data.chatMessages.filter((m: any) => !existingIds.has(m.id));
            return [...prev, ...newMsgs];
          });
        }
      });
    }
  }, [supabaseConfig.isConnected, userProfile.id]);

  // Handlers
  const handleToggleShortlist = (candidateId: string) => {
    setShortlistedIds((prev) => {
      const exists = prev.includes(candidateId);
      if (exists) {
        syncUnlikeToSupabase(userProfile.id, candidateId);
        return prev.filter((id) => id !== candidateId);
      } else {
        syncLikeToSupabase(userProfile.id, candidateId);
        return [...prev, candidateId];
      }
    });
  };

  const handleExpressInterest = (candidateId: string) => {
    if (!spendCredit()) return; // Block if no credits

    setInterestedIds((prev) => {
      if (prev.includes(candidateId)) return prev;
      return [...prev, candidateId];
    });

    // Automatically create a connection request record & sync to Supabase
    setConnectionRequests((prev) => [
      ...prev,
      {
        id: `req-${Date.now()}`,
        fromUserId: userProfile.id,
        toProfileId: candidateId,
        status: 'pending',
        sentAt: 'Just now',
        message: 'Expressed interest in your profile!'
      }
    ]);

    // Supabase sync
    syncLikeToSupabase(userProfile.id, candidateId);
  };

  const handleSkipCandidate = (candidateId: string) => {
    if (!spendCredit()) return; // Block if no credits
    setSkippedIds((prev) => (prev.includes(candidateId) ? prev : [...prev, candidateId]));
  };

  const handleRemoveLike = (candidateId: string) => {
    setInterestedIds((prev) => prev.filter((id) => id !== candidateId));
    setShortlistedIds((prev) => prev.filter((id) => id !== candidateId));

    // Supabase sync
    syncUnlikeToSupabase(userProfile.id, candidateId);
  };

  const handleUnskipCandidate = (candidateId: string) => {
    setSkippedIds((prev) => prev.filter((id) => id !== candidateId));
  };

  const handleSendMessage = (matchId: string, text: string, isIcebreaker = false) => {
    const newMsg: ChatMessage = {
      id: `msg-${Date.now()}`,
      matchId,
      senderId: 'currentUser',
      text,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      status: 'delivered',
      isIcebreaker
    };

    setMessages((prev) => [...prev, newMsg]);

    // Supabase sync
    syncMessageToSupabase('currentUser', matchId, text);

    // Simulate realistic automated reply after 2 seconds
    setTimeout(() => {
      const matchCandidate = candidates.find((c) => c.id === matchId);
      const autoReply: ChatMessage = {
        id: `msg-reply-${Date.now()}`,
        matchId,
        senderId: matchId,
        text: `Thank you for your message! ${matchCandidate?.name || 'I'} will discuss with family and get back to you soon.`,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        status: 'read'
      };
      setMessages((prev) => [...prev, autoReply]);
    }, 2000);
  };

  const handleAcceptRequest = (requestId: string) => {
    setConnectionRequests((prev) =>
      prev.map((r) => (r.id === requestId ? { ...r, status: 'accepted' as const } : r))
    );
  };

  const handleDeclineRequest = (requestId: string) => {
    setConnectionRequests((prev) => prev.filter((r) => r.id !== requestId));
  };

  const handleResetFilters = () => {
    setFilters({
      gender: 'Female',
      ageMin: 20,
      ageMax: 50,
      heightMinInches: 54,
      heightMaxInches: 78,
      religions: [],
      castes: [],
      maritalStatuses: [],
      minIncome: '',
      city: '',
      state: '',
      manglikPreference: 'All',
      verifiedOnly: false,
      withPhotosOnly: false,
      searchQuery: ''
    });
  };

  return (
    <div className="w-full min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans select-none overflow-x-hidden">
      {/* Main Container */}
      <FlutterDeviceFrame device="fullscreen">
        <div className="w-full h-full flex flex-col overflow-hidden bg-slate-950 relative">
          
          {/* Active Tab View Render */}
          {activeTab === 'discover' && (
            <DiscoverView
              candidates={candidates}
              filters={filters}
              userProfile={userProfile}
              onOpenFilterDrawer={() => setIsFilterOpen(true)}
              onSelectCandidate={(candidate) => setSelectedCandidate(candidate)}
              onExpressInterest={handleExpressInterest}
              onShortlistToggle={handleToggleShortlist}
              onSkipCandidate={handleSkipCandidate}
              shortlistedIds={shortlistedIds}
              interestedIds={interestedIds}
              skippedIds={skippedIds}
              onStartChat={(candidate) => {
                setActiveChatProfile(candidate);
                setActiveTab('chats');
              }}
              credits={credits}
              maxCredits={maxCredits}
              timeUntilReset={timeUntilReset}
            />
          )}

          {activeTab === 'likes' && (
            <LikesView
              candidates={candidates}
              interestedIds={interestedIds}
              shortlistedIds={shortlistedIds}
              skippedIds={skippedIds}
              connectionRequestFromIds={connectionRequests.map((r) => r.fromUserId)}
              onExpressInterest={handleExpressInterest}
              onRemoveLike={handleRemoveLike}
              onSkipCandidate={handleSkipCandidate}
              onUnskipCandidate={handleUnskipCandidate}
              onSelectCandidate={(candidate) => setSelectedCandidate(candidate)}
              onStartChat={(candidate) => {
                setActiveChatProfile(candidate);
                setActiveTab('chats');
              }}
            />
          )}

          {activeTab === 'chats' && (
            <SecureChatView
              candidates={candidates}
              activeChatProfile={activeChatProfile}
              setActiveChatProfile={setActiveChatProfile}
              messages={messages}
              onSendMessage={handleSendMessage}
              connectionRequests={connectionRequests.filter((r) => r.status === 'pending')}
              onAcceptRequest={handleAcceptRequest}
              onDeclineRequest={handleDeclineRequest}
              interestedIds={interestedIds}
            />
          )}

          {activeTab === 'my_profile' && (
            <MyProfileView
              userProfile={userProfile}
              setUserProfile={setUserProfile}
              credits={credits}
              maxCredits={maxCredits}
              timeUntilReset={timeUntilReset}
            />
          )}

          {/* Bottom Flutter Navigation Bar */}
          <BottomNavBar
            activeTab={activeTab}
            setActiveTab={setActiveTab}
            unreadChatCount={messages.filter((m) => m.status !== 'read' && m.senderId !== 'currentUser').length}
            discoverCount={candidates.length}
            likesCount={interestedIds.length + shortlistedIds.length}
          />

          {/* Slide-out Filter Drawer (Fit strictly within mobile device frame) */}
          <FilterDrawer
            isOpen={isFilterOpen}
            onClose={() => setIsFilterOpen(false)}
            filters={filters}
            setFilters={setFilters}
            onResetFilters={handleResetFilters}
          />

          {/* Candidate Profile Detail Modal (Fit strictly within mobile device frame) */}
          <ProfileDetailModal
            candidate={selectedCandidate}
            userProfile={userProfile}
            onClose={() => setSelectedCandidate(null)}
            onExpressInterest={handleExpressInterest}
            onRemoveLike={handleRemoveLike}
            onShortlistToggle={handleToggleShortlist}
            onStartChat={(candidate) => {
              setActiveChatProfile(candidate);
              setActiveTab('chats');
            }}
            isShortlisted={selectedCandidate ? shortlistedIds.includes(selectedCandidate.id) : false}
            isInterested={selectedCandidate ? interestedIds.includes(selectedCandidate.id) : false}
          />

          {/* Onboarding Screens (Shows after Login/Signup if not completed yet or replayed) */}
          {showOnboarding && !showLoginScreen && (
            <OnboardingScreen onComplete={handleCompleteOnboarding} />
          )}

          {/* Login / Signup Screen (Shows BEFORE Onboarding on initial app open or after logout) */}
          {showLoginScreen && (
            <AuthLoginScreen
              onLoginSuccess={handleLoginSuccess}
              supabaseConfig={supabaseConfig}
              setSupabaseConfig={setSupabaseConfig}
            />
          )}
        </div>

        {/* WebRTC Call Overlay */}
        <CallOverlay
          callState={callState}
          callType={callType}
          remotePeerName={
            incomingCall
              ? incomingCall.callerName
              : remotePeerId
                ? candidates.find((c) => c.id === remotePeerId)?.name || 'Unknown'
                : ''
          }
          remotePeerAvatar={
            incomingCall
              ? incomingCall.callerAvatar
              : remotePeerId
                ? candidates.find((c) => c.id === remotePeerId)?.avatarUrl || ''
                : ''
          }
          localStream={localStream}
          remoteStream={remoteStream}
          isMuted={isMuted}
          isCameraOff={isCameraOff}
          onAccept={acceptCall}
          onDecline={declineCall}
          onEnd={endCall}
          onToggleMute={toggleMute}
          onToggleCamera={toggleCamera}
        />
      </FlutterDeviceFrame>
    </div>
  );
}
</file>

