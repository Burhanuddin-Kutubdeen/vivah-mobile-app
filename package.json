{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "android:deploy": "powershell -ExecutionPolicy Bypass -File scripts/build-and-deploy.ps1",
    "android:release": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.0.1",
    "react-image-file-resizer": "^0.4.8",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
